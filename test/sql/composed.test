# name: test/sql/composed.test
# description: Composed examples (several netflow objects in one query) and the
#              composed agent-task graders, pinned byte-for-byte as published:
#              the SQL below is copied from meta.rs composed_* / vgi-agent-tests.yaml.
# group: [vgi_netflow]

require-env VGI_NETFLOW_WORKER

statement ok
LOAD vgi;

statement ok
ATTACH 'netflow' AS netflow (TYPE vgi, LOCATION '${VGI_NETFLOW_WORKER}');

# flows + supported_formats: per-format rollup of a mixed batch.
query TTII
SELECT s.format, s.rfc, count(*) AS decoded_rows, sum(f.bytes) AS total_bytes FROM netflow.main.flows((SELECT from_hex(h) AS datagram FROM (VALUES ('00050002000186a06553f100000000000000000a000100000a0000010a0000020a0000fe000100020000000a000003e800015f900001731804d2005000180600fbf4fbf518180000c0a80101080808080a0000fe0001000200000002000000c800015f900001731814e900350000110000003b4118180000'), ('00090002000186a06553f1000000001400000001000000240100000700080004000c000400070002000b000200040001000200040001000401000019ac100001ac100002045700160600000003000000b4'), ('000a006d6553f100000000070000002a0002002c0100000900080004000c000400070002000b0002000400010001000800020008009800080099000801000031cb007105c633640980e801bb06000000000016e36000000000000004b00000018bcfe568000000018bcfe58f10'), ('')) AS t(h))) AS f JOIN netflow.main.supported_formats AS s ON s.flow_version = f.flow_version GROUP BY s.format, s.rfc ORDER BY s.format, s.rfc
----
IPFIX	RFC 7011	1	1500000
NetFlow	Cisco NetFlow v5	2	1200
NetFlow	RFC 3954	1	180
sFlow	sFlow.org v5	2	262144

# flow_version + supported_formats: route each datagram to its decoder.
query TTTT
SELECT c.capture, netflow.main.flow_version(c.datagram) AS version, s.format, s.decoder FROM (VALUES ('router-a', from_hex('00050002000186a06553f100000000000000000a000100000a0000010a0000020a0000fe000100020000000a000003e800015f900001731804d2005000180600fbf4fbf518180000c0a80101080808080a0000fe0001000200000002000000c800015f900001731814e900350000110000003b4118180000')), ('router-b', from_hex('000a006d6553f100000000070000002a0002002c0100000900080004000c000400070002000b0002000400010001000800020008009800080099000801000031cb007105c633640980e801bb06000000000016e36000000000000004b00000018bcfe568000000018bcfe58f10')), ('switch-c', from_hex('')), ('junk', '\xde\xad'::BLOB)) AS c(capture, datagram) LEFT JOIN netflow.main.supported_formats AS s ON s.flow_version = netflow.main.flow_version(c.datagram) ORDER BY c.capture
----
junk	NULL	NULL	NULL
router-a	5	NetFlow	netflow_decode
router-b	10	IPFIX	ipfix_decode
switch-c	sflow5	sFlow	sflow_decode

# well_formed + flows: decode only the captures that validate.
query TII
SELECT f.exporter, count(*) AS flows, sum(f.bytes) AS total_bytes FROM netflow.main.flows((SELECT c.datagram, c.capture AS exporter FROM (VALUES ('router-a', from_hex('00050002000186a06553f100000000000000000a000100000a0000010a0000020a0000fe000100020000000a000003e800015f900001731804d2005000180600fbf4fbf518180000c0a80101080808080a0000fe0001000200000002000000c800015f900001731814e900350000110000003b4118180000')), ('router-t', from_hex('00050002000186a06553f100000000000000000a000100000a0000010a0000020a0000fe000100020000000a000003e800015f900001731804d20050')), ('router-9', from_hex('00090002000186a06553f1000000001400000001000000240100000700080004000c000400070002000b000200040001000200040001000401000019ac100001ac100002045700160600000003000000b4'))) AS c(capture, datagram) WHERE netflow.main.well_formed(c.datagram).ok)) AS f GROUP BY f.exporter ORDER BY f.exporter
----
router-9	1	180
router-a	2	1200

# header + netflow_decode: declared vs clean record counts.
query TII
WITH caps AS (SELECT exporter, datagram FROM (VALUES ('router-a', from_hex('00050002000186a06553f100000000000000000a000100000a0000010a0000020a0000fe000100020000000a000003e800015f900001731804d2005000180600fbf4fbf518180000c0a80101080808080a0000fe0001000200000002000000c800015f900001731814e900350000110000003b4118180000')), ('router-b', from_hex('00050002000186a06553f100000000000000000a000100000a0000010a0000020a0000fe000100020000000a000003e800015f900001731804d20050'))) AS t(exporter, datagram)) SELECT c.exporter, netflow.main.header(c.datagram).count AS declared_records, coalesce(d.clean_rows, 0) AS clean_rows FROM caps AS c LEFT JOIN (SELECT exporter, count(*) FILTER (WHERE diagnostics IS NULL) AS clean_rows FROM netflow.main.netflow_decode((SELECT datagram, exporter FROM caps)) GROUP BY exporter) AS d ON d.exporter = c.exporter ORDER BY c.exporter
----
router-a	2	2
router-b	2	0

# Grader route_by_decoder (flow_version + supported_formats).
query TI
SELECT s.decoder, count(*) AS datagrams FROM (VALUES (from_hex('00050002000186a06553f100000000000000000a000100000a0000010a0000020a0000fe000100020000000a000003e800015f900001731804d2005000180600fbf4fbf518180000c0a80101080808080a0000fe0001000200000002000000c800015f900001731814e900350000110000003b4118180000')), (from_hex('00090002000186a06553f1000000001400000001000000240100000700080004000c000400070002000b000200040001000200040001000401000019ac100001ac100002045700160600000003000000b4')), (from_hex('000a006d6553f100000000070000002a0002002c0100000900080004000c000400070002000b0002000400010001000800020008009800080099000801000031cb007105c633640980e801bb06000000000016e36000000000000004b00000018bcfe568000000018bcfe58f10')), (from_hex('00050002000186a06553f100000000000000000a000100000a0000010a0000020a0000fe000100020000000a000003e800015f900001731804d2005000180600fbf4fbf518180000c0a80101080808080a0000fe0001000200000002000000c800015f900001731814e900350000110000003b4118180000')), (from_hex('dead'))) AS t(datagram) JOIN netflow.main.supported_formats AS s ON s.flow_version = netflow.main.flow_version(t.datagram) GROUP BY s.decoder ORDER BY s.decoder
----
ipfix_decode	1
netflow_decode	3

# Grader find_short_capture (header + netflow_decode).
query T
WITH caps AS (SELECT exporter, datagram FROM (VALUES ('router-a', from_hex('00050002000186a06553f100000000000000000a000100000a0000010a0000020a0000fe000100020000000a000003e800015f900001731804d2005000180600fbf4fbf518180000c0a80101080808080a0000fe0001000200000002000000c800015f900001731814e900350000110000003b4118180000')), ('router-b', from_hex('00050002000186a06553f100000000000000000a000100000a0000010a0000020a0000fe000100020000000a000003e800015f900001731804d20050'))) AS t(exporter, datagram)), clean AS (SELECT exporter, count(*) AS n FROM netflow.main.netflow_decode((SELECT datagram, exporter FROM caps)) WHERE diagnostics IS NULL GROUP BY exporter) SELECT c.exporter FROM caps AS c LEFT JOIN clean AS k ON k.exporter = c.exporter WHERE coalesce(k.n, 0) < netflow.main.header(c.datagram).count ORDER BY c.exporter
----
router-b
